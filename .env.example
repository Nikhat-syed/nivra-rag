# Environment Variables for Nivra RAG System

# OpenAI API Key (for GPT-4o / GPT-4o-mini universal answer synthesis)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (for Llama 3.3 70b answer synthesis)
GROQ_API_KEY=your_groq_api_key_here

# Local Vector Database Path
QDRANT_URL=local

# Supabase Database Credentials (PostgreSQL / pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here
